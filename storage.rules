rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isSafeImage() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /profiles/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if isOwner(uid) && isSafeImage();
    }

    match /posts/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if isOwner(uid) && isSafeImage();
    }

    // 캐릭터 에셋: characters/{type}/{type}_S|M|L.png (콘솔에서만 업로드)
    match /characters/{type}/{fileName} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /camera/{uid}/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isSafeImage();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
